# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Shared pooled connection for the Facilities team role
DB_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# Shared schema assigned to the Facilities module
DB_SCHEMA="facilities_schema"

# Legacy fallback variables kept for compatibility with older scripts.
# New setup should use DB_URL + DB_SCHEMA instead.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# ─── Better-Auth ──────────────────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"

# Optional explicit base URL of the running application.
# Local example:
# BETTER_AUTH_URL="http://localhost:3000"
# On Vercel, this can usually be omitted because Better Auth can infer the host.
# Set it only if you want to force a custom production URL.
# BETTER_AUTH_URL="https://your-domain.com"

# ─── Application ──────────────────────────────────────────────────────────────
# Optional public app URL. Not required when the browser uses the current origin.
# NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Optional consumer API token. Leave unset to keep documented GET endpoints open.
# When set, clients must send this token with Authorization: Bearer <token>
# or x-api-token: <token> unless they already have an authenticated app session.
# FACILITIES_API_TOKEN="replace-with-a-shared-api-token"

# ─── Scheduler Integration ────────────────────────────────────────────────────
# Base URL for the external Scheduler module API
# If not available, the app uses a typed fallback response
SCHEDULER_API_BASE_URL="http://localhost:4000"

# Milliseconds before the scheduler API request times out
SCHEDULER_API_TIMEOUT_MS="3000"
